<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <Configurations>Debug;Release</Configurations>
    <Optimize Condition="$(Configuration.StartsWith('Release'))">true</Optimize>
    <PackageProjectUrl>https://github.com/Broiler-Platform/Broiler.Hosting</PackageProjectUrl>
    <PackageTags>broiler;hosting;desktop;windows</PackageTags>
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix>preview.1</VersionSuffix>
  </PropertyGroup>
</Project>
