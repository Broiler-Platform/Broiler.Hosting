<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <BroilerUiVersion>0.1.0-preview.18</BroilerUiVersion>
    <BroilerGraphicsVersion>0.1.0-preview.7</BroilerGraphicsVersion>
    <BroilerNativeVersion>0.1.0-preview.6</BroilerNativeVersion>
    <BroilerInputVersion>0.1.0-preview.5</BroilerInputVersion>
    <!-- Printing: IUiPrintHost and the print controls arrive in Broiler.UI 0.1.0-preview.21, the
         page model in Broiler.Graphics 0.1.0-preview.13, and the spooler and CUPS bindings in
         Broiler.Native 0.1.0-preview.9. Properties, so a build against local packs can name them. -->
    <BroilerUiPackageVersion Condition="'$(BroilerUiPackageVersion)' == ''">0.1.0-preview.21</BroilerUiPackageVersion>
    <BroilerGraphicsPackageVersion Condition="'$(BroilerGraphicsPackageVersion)' == ''">0.1.0-preview.13</BroilerGraphicsPackageVersion>
    <BroilerNativePackageVersion Condition="'$(BroilerNativePackageVersion)' == ''">0.1.0-preview.9</BroilerNativePackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Broiler.UI" Version="$(BroilerUiPackageVersion)" />
    <PackageVersion Include="Broiler.UI.Standard" Version="$(BroilerUiPackageVersion)" />
    <PackageVersion Include="Broiler.UI.Button" Version="$(BroilerUiPackageVersion)" />
    <PackageVersion Include="Broiler.UI.Button.Standard" Version="$(BroilerUiPackageVersion)" />
    <PackageVersion Include="Broiler.UI.ComboBox" Version="$(BroilerUiPackageVersion)" />
    <PackageVersion Include="Broiler.UI.ComboBox.Standard" Version="$(BroilerUiPackageVersion)" />
    <PackageVersion Include="Broiler.UI.Edit" Version="$(BroilerUiPackageVersion)" />
    <PackageVersion Include="Broiler.UI.Forms.Standard" Version="$(BroilerUiPackageVersion)" />
    <PackageVersion Include="Broiler.UI.Label.Standard" Version="$(BroilerUiPackageVersion)" />
    <PackageVersion Include="Broiler.UI.Edit.Standard" Version="$(BroilerUiPackageVersion)" />
    <PackageVersion Include="Broiler.UI.FormatCodeView.Standard" Version="$(BroilerUiPackageVersion)" />
    <PackageVersion Include="Broiler.UI.ListView" Version="$(BroilerUiPackageVersion)" />
    <PackageVersion Include="Broiler.UI.ListView.Standard" Version="$(BroilerUiPackageVersion)" />
    <PackageVersion Include="Broiler.UI.Panel.Standard" Version="$(BroilerUiPackageVersion)" />
    <PackageVersion Include="Broiler.UI.RichEdit" Version="$(BroilerUiPackageVersion)" />
    <PackageVersion Include="Broiler.UI.RichEdit.Standard" Version="$(BroilerUiPackageVersion)" />
    <PackageVersion Include="Broiler.UI.ScrollView.Standard" Version="$(BroilerUiPackageVersion)" />
    <PackageVersion Include="Broiler.UI.SpinBox.Standard" Version="$(BroilerUiPackageVersion)" />
    <PackageVersion Include="Broiler.UI.TabView" Version="$(BroilerUiPackageVersion)" />
    <PackageVersion Include="Broiler.UI.TabView.Standard" Version="$(BroilerUiPackageVersion)" />
    <PackageVersion Include="Broiler.UI.ToggleButton.Standard" Version="$(BroilerUiPackageVersion)" />
    <PackageVersion Include="Broiler.UI.Toolbar.Standard" Version="$(BroilerUiPackageVersion)" />
    <PackageVersion Include="Broiler.UI.TreeView" Version="$(BroilerUiPackageVersion)" />
    <PackageVersion Include="Broiler.UI.TreeView.Standard" Version="$(BroilerUiPackageVersion)" />
    <PackageVersion Include="Broiler.Graphics" Version="$(BroilerGraphicsPackageVersion)" />
    <PackageVersion Include="Broiler.Graphics.Windows" Version="0.1.0-preview.12" />
    <PackageVersion Include="Broiler.Graphics.Linux" Version="0.1.0-preview.12" />
    <PackageVersion Include="Broiler.Graphics.Linux.OpenGL" Version="0.1.0-preview.12" />
    <PackageVersion Include="Broiler.Graphics.Android" Version="$(BroilerGraphicsVersion)" />
    <PackageVersion Include="Broiler.Native" Version="$(BroilerNativePackageVersion)" />
    <PackageVersion Include="Broiler.Native.Windows" Version="$(BroilerNativePackageVersion)" />
    <PackageVersion Include="Broiler.Native.Linux" Version="$(BroilerNativePackageVersion)" />
    <PackageVersion Include="Broiler.Native.Android" Version="$(BroilerNativeVersion)" />
    <PackageVersion Include="Broiler.Input" Version="0.1.0-preview.6" />
    <PackageVersion Include="Broiler.Input.Keyboard" Version="0.1.0-preview.6" />
    <PackageVersion Include="Broiler.Input.Keyboard.Windows" Version="$(BroilerInputVersion)" />
    <PackageVersion Include="Broiler.Input.Keyboard.Linux" Version="0.1.0-preview.6" />
    <PackageVersion Include="Broiler.Input.Keyboard.Android" Version="0.1.0-preview.6" />
    <PackageVersion Include="Broiler.Input.Mouse" Version="0.1.0-preview.6" />
    <PackageVersion Include="Broiler.Input.Mouse.Windows" Version="$(BroilerInputVersion)" />
    <PackageVersion Include="Broiler.Input.Mouse.Linux" Version="0.1.0-preview.6" />
    <PackageVersion Include="Broiler.Input.Pen" Version="$(BroilerInputVersion)" />
    <PackageVersion Include="Broiler.Input.Pen.Android" Version="0.1.0-preview.6" />
    <PackageVersion Include="Broiler.Input.Text" Version="$(BroilerInputVersion)" />
    <PackageVersion Include="Broiler.Input.Text.Android" Version="0.1.0-preview.6" />
    <PackageVersion Include="Broiler.Input.Touch" Version="$(BroilerInputVersion)" />
    <PackageVersion Include="Broiler.Input.Touch.Android" Version="0.1.0-preview.6" />
    <PackageVersion Include="Broiler.Input.Linux" Version="0.1.0-preview.6" />
    <PackageVersion Include="Broiler.Input.Android" Version="0.1.0-preview.6" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
</Project>