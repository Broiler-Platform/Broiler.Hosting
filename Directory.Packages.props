<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <BroilerUiVersion>0.1.0-preview.24</BroilerUiVersion>
    <BroilerGraphicsVersion>0.1.0-preview.14</BroilerGraphicsVersion>
    <BroilerNativeVersion>0.1.0-preview.10</BroilerNativeVersion>
    <BroilerInputVersion>0.1.0-preview.7</BroilerInputVersion>
    <!-- Printing: IUiPrintHost and the print controls arrive in Broiler.UI 0.1.0-preview.22, the
         page model in Broiler.Graphics 0.1.0-preview.13, and the spooler and CUPS bindings in
         Broiler.Native 0.1.0-preview.9. Properties, so a build against local packs can name them. -->
    <BroilerUiPackageVersion Condition="'$(BroilerUiPackageVersion)' == ''">0.1.0-preview.24</BroilerUiPackageVersion>
    <BroilerGraphicsPackageVersion Condition="'$(BroilerGraphicsPackageVersion)' == ''">0.1.0-preview.14</BroilerGraphicsPackageVersion>
    <BroilerNativePackageVersion Condition="'$(BroilerNativePackageVersion)' == ''">0.1.0-preview.10</BroilerNativePackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Broiler.UI" Version="0.1.0-preview.36" />
    <PackageVersion Include="Broiler.UI.PrintDialog" Version="0.1.0-preview.36" />
    <PackageVersion Include="Broiler.UI.ScanDialog" Version="0.1.0-preview.36" />
    <PackageVersion Include="Broiler.UI.Standard" Version="0.1.0-preview.36" />
    <PackageVersion Include="Broiler.UI.Button" Version="0.1.0-preview.36" />
    <PackageVersion Include="Broiler.UI.Button.Standard" Version="0.1.0-preview.36" />
    <PackageVersion Include="Broiler.UI.ComboBox" Version="0.1.0-preview.36" />
    <PackageVersion Include="Broiler.UI.ComboBox.Standard" Version="0.1.0-preview.36" />
    <PackageVersion Include="Broiler.UI.Edit" Version="0.1.0-preview.36" />
    <PackageVersion Include="Broiler.UI.Forms.Standard" Version="0.1.0-preview.36" />
    <PackageVersion Include="Broiler.UI.Label.Standard" Version="0.1.0-preview.36" />
    <PackageVersion Include="Broiler.UI.Edit.Standard" Version="0.1.0-preview.36" />
    <PackageVersion Include="Broiler.UI.FormatCodeView.Standard" Version="0.1.0-preview.36" />
    <PackageVersion Include="Broiler.UI.ListView" Version="0.1.0-preview.36" />
    <PackageVersion Include="Broiler.UI.ListView.Standard" Version="0.1.0-preview.36" />
    <PackageVersion Include="Broiler.UI.Panel.Standard" Version="0.1.0-preview.36" />
    <PackageVersion Include="Broiler.UI.RichEdit" Version="0.1.0-preview.36" />
    <PackageVersion Include="Broiler.UI.RichEdit.Standard" Version="0.1.0-preview.36" />
    <PackageVersion Include="Broiler.UI.ScrollView.Standard" Version="0.1.0-preview.36" />
    <PackageVersion Include="Broiler.UI.SpinBox.Standard" Version="0.1.0-preview.36" />
    <PackageVersion Include="Broiler.UI.TabView" Version="0.1.0-preview.36" />
    <PackageVersion Include="Broiler.UI.TabView.Standard" Version="0.1.0-preview.36" />
    <PackageVersion Include="Broiler.UI.ToggleButton.Standard" Version="0.1.0-preview.36" />
    <PackageVersion Include="Broiler.UI.Toolbar.Standard" Version="0.1.0-preview.36" />
    <PackageVersion Include="Broiler.UI.TreeView" Version="0.1.0-preview.36" />
    <PackageVersion Include="Broiler.UI.TreeView.Standard" Version="0.1.0-preview.36" />
    <PackageVersion Include="Broiler.Graphics" Version="0.1.0-preview.19" />
    <PackageVersion Include="Broiler.Graphics.Windows" Version="0.1.0-preview.19" />
    <PackageVersion Include="Broiler.Graphics.Linux" Version="0.1.0-preview.19" />
    <PackageVersion Include="Broiler.Graphics.Linux.OpenGL" Version="0.1.0-preview.19" />
    <PackageVersion Include="Broiler.Graphics.Android" Version="$(BroilerGraphicsVersion)" />
    <PackageVersion Include="Broiler.Native" Version="0.1.0-preview.12" />
    <PackageVersion Include="Broiler.Native.Windows" Version="0.1.0-preview.12" />
    <PackageVersion Include="Broiler.Native.Linux" Version="0.1.0-preview.12" />
    <PackageVersion Include="Broiler.Native.Android" Version="$(BroilerNativeVersion)" />
    <PackageVersion Include="Broiler.Input" Version="0.1.0-preview.9" />
    <PackageVersion Include="Broiler.Input.Keyboard" Version="0.1.0-preview.9" />
    <PackageVersion Include="Broiler.Input.Keyboard.Windows" Version="$(BroilerInputVersion)" />
    <PackageVersion Include="Broiler.Input.Keyboard.Linux" Version="0.1.0-preview.9" />
    <PackageVersion Include="Broiler.Input.Keyboard.Android" Version="0.1.0-preview.9" />
    <PackageVersion Include="Broiler.Input.Mouse" Version="0.1.0-preview.9" />
    <PackageVersion Include="Broiler.Input.Mouse.Windows" Version="$(BroilerInputVersion)" />
    <PackageVersion Include="Broiler.Input.Mouse.Linux" Version="0.1.0-preview.9" />
    <PackageVersion Include="Broiler.Input.Pen" Version="$(BroilerInputVersion)" />
    <PackageVersion Include="Broiler.Input.Pen.Android" Version="0.1.0-preview.9" />
    <PackageVersion Include="Broiler.Input.Text" Version="$(BroilerInputVersion)" />
    <PackageVersion Include="Broiler.Input.Text.Android" Version="0.1.0-preview.9" />
    <PackageVersion Include="Broiler.Input.Touch" Version="$(BroilerInputVersion)" />
    <PackageVersion Include="Broiler.Input.Touch.Android" Version="0.1.0-preview.9" />
    <PackageVersion Include="Broiler.Input.Linux" Version="0.1.0-preview.9" />
    <PackageVersion Include="Broiler.Input.Android" Version="0.1.0-preview.9" />
    <PackageVersion Include="Broiler.Input.Scanner" Version="0.1.0-preview.9" />
    <PackageVersion Include="Broiler.Input.Scanner.Linux" Version="0.1.0-preview.9" />
    <PackageVersion Include="Broiler.Input.Scanner.Windows" Version="0.1.0-preview.9" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>
</Project>